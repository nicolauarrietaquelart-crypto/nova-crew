{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-crew-demo",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api*"]
  },
  "durable_objects": {
    "bindings": [
      {"name": "NOVA_STATE", "class_name": "DemoState"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["DemoState"]}
  ]
}
